  if (!FieldStorageConfig::loadByName('node', 'field_image_prompts_file')) {
    FieldStorageConfig::create([
      'field_name' => 'field_image_prompts_file',
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => ['target_type' => 'file', 'display_field' => FALSE, 'display_default' => FALSE],
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_image_prompts_file')) {
    FieldConfig::create([
      'field_name' => 'field_image_prompts_file',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'Image prompts file',
      'settings' => ['file_extensions' => 'txt', 'file_directory' => 'story-pipeline/[date:custom:Y-m]'],
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_eleven_labs_files')) {
    FieldStorageConfig::create([
      'field_name' => 'field_eleven_labs_files',
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => ['target_type' => 'file', 'display_field' => FALSE, 'display_default' => FALSE],
      'cardinality' => -1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_eleven_labs_files')) {
    FieldConfig::create([
      'field_name' => 'field_eleven_labs_files',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'ElevenLabs audio',
      'settings' => ['file_extensions' => 'mp3', 'file_directory' => 'story-pipeline/eleven-labs/[date:custom:Y-m]'],
    ])->save();
