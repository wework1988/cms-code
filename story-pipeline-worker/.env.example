# Drupal site (no trailing slash)
DRUPAL_BASE_URL=http://localhost:8888/myresearch2/web

# From: drush story-pipeline:info  (Drupal API key — NOT DeepSeek)
DRUPAL_API_KEY=your_drupal_api_key_here

# Read-only path to automation repo (documentary-engine + library)
AUTOMATION_REPO=/Users/averma/project/research-story-17thmay-automation

# Permanent story outputs (prompts, scenes, audio, research, etc.)
STORY_ASSET_ROOT=/Applications/MAMP/htdocs/myresearch2/cms-generate-stories

# Mirror every story folder here too (automation repo for local editing)
STORY_ASSET_MIRROR=/Users/averma/project/research-story-17thmay-automation/cms-generate-stories

# Optional: override pointer-extract prompt (default: STORY_ASSET_MIRROR/bullet promt if present)
# STORY_BULLET_PROMPT_PATH=/Users/averma/project/research-story-17thmay-automation/cms-generate-stories/bullet promt

# YouTube transcript auth (fixes long-lived IpBlocked from transcript API)
# Option A: unused Firefox profile folder name — log into youtube.com in that profile first
# Open profile without closing main Firefox: firefox -no-remote -P "automation-profile2"
YOUTUBE_COOKIES_BROWSER=firefox:vy657nkd.automation-profile2
# Option B: exported Netscape cookies.txt (Chrome/Firefox extension export)
# YOUTUBE_COOKIES_FILE=/Users/you/youtube-cookies.txt
# Requires: brew install deno  (yt-dlp JS challenge solving)

# Optional overrides (Drupal per-type keys take priority when set)
# If empty here, worker loads DEEPSEEK_API_KEY from AUTOMATION_REPO/.env automatically
# DEEPSEEK_API_KEY=
# Optional key pool for parallel runs (comma-separated). Worker auto-allocates a less-busy key per job.
# Leave Drupal DeepSeek key empty if you want this pool to control all storyboard jobs.
# DEEPSEEK_API_KEYS=sk-key-1,sk-key-2
# ANTHROPIC_API_KEY=
