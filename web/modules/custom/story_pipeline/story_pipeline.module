<?php

/**
 * @file
 * Story Pipeline hooks.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\NodeInterface;
use Drupal\Core\Url;
use Drupal\views\ViewExecutable;
/**
 * Implements hook_theme().
 */
function story_pipeline_theme($existing, $type, $theme, $path): array {
  return [
    'story_pipeline_progress' => [
      'variables' => [
        'progress' => [],
        'story_id' => 0,
      ],
      'template' => 'story-pipeline-progress',
    ],
    'story_pipeline_workspace_nav' => [
      'variables' => [
        'primary' => [],
        'secondary' => [],
      ],
      'template' => 'story-pipeline-workspace-nav',
    ],
  ];
}

/**
 * Implements hook_toolbar().
 */
function story_pipeline_toolbar(): array {
  $account = \Drupal::currentUser();
  $items = [];

  if ($account->hasPermission('run story pipeline jobs')) {
    $items['story_pipeline_runner'] = [
      '#type' => 'toolbar_item',
      'tab' => [
        '#type' => 'link',
        '#title' => (string) t('Run story jobs'),
        '#url' => Url::fromRoute('story_pipeline.run'),
        '#options' => [
          'attributes' => [
            'title' => (string) t('Run story jobs'),
            'class' => ['toolbar-icon', 'toolbar-item'],
          ],
        ],
      ],
      '#weight' => 115,
      '#cache' => ['contexts' => ['user.permissions']],
    ];
  }

  if ($account->hasPermission('track stories')) {
    $items['story_pipeline_planner'] = [
      '#type' => 'toolbar_item',
      'tab' => [
        '#type' => 'link',
        '#title' => (string) t('Story planner'),
        '#url' => Url::fromRoute('story_pipeline.tracker'),
        '#options' => [
          'attributes' => [
            'title' => (string) t('Story planner'),
            'class' => ['toolbar-icon', 'toolbar-item'],
          ],
        ],
      ],
      '#weight' => 116,
      '#cache' => ['contexts' => ['user.permissions']],
    ];
  }

  return $items;
}

/**
 * Implements hook_help().
 */
function story_pipeline_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.story_pipeline') {
    return (string) t('Story Pipeline: Story Type taxonomy + Story content type + REST API. See module README.md.');
  }
  return '';
}

/**
 * Add Characters shortcut on story edit form.
 */
function story_pipeline_form_node_story_edit_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();
  if (!$node->id()) {
    return;
  }

  $account = \Drupal::currentUser();
  $allowed = FALSE;
  foreach (\Drupal\story_pipeline\Access\StoryPipelineStaffAccessCheck::PERMISSIONS as $permission) {
    if ($account->hasPermission($permission)) {
      $allowed = TRUE;
      break;
    }
  }
  if (!$allowed) {
    return;
  }

  $form['story_pipeline_characters_link'] = [
    '#type' => 'link',
    '#title' => t('Manage characters →'),
    '#url' => Url::fromRoute('story_pipeline.story_characters', ['node' => $node->id()]),
    '#weight' => -100,
    '#prefix' => '<div class="story-pipeline-characters-link messages messages--info">',
    '#suffix' => '</div>',
    '#attributes' => ['class' => ['button', 'button--primary']],
  ];

  /** @var \Drupal\story_pipeline\Service\CharacterLibrary $character_library */
  $character_library = \Drupal::service('story_pipeline.character_library');
  $status = $character_library->getCharacterStatus($node);
  if ($status['total'] > 0 || $status['applied'] > 0) {
    $parts = [];
    if ($status['total'] > 0) {
      $parts[] = t('@tagged of @total tagged', [
        '@tagged' => $status['tagged'],
        '@total' => $status['total'],
      ]);
    }
    if ($status['applied'] > 0) {
      $parts[] = t('@count in pipeline', ['@count' => $status['applied']]);
    }
    $form['story_pipeline_characters_status'] = [
      '#type' => 'markup',
      '#markup' => '<div class="story-pipeline-characters-status messages messages--status">' . implode(' · ', $parts) . '</div>',
      '#weight' => -99,
    ];
  }
}

/**
 * Default admin content listing to stories; add Stories / All content tabs.
 */
function story_pipeline_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {
  if ($view->id() !== 'content' || $display_id !== 'page_1') {
    return;
  }
  if (\Drupal::request()->query->get('all') === '1') {
    return;
  }
  $input = $view->getExposedInput();
  if (isset($input['type']) && $input['type'] !== '' && $input['type'] !== NULL) {
    return;
  }
  $input['type'] = 'story';
  $view->setExposedInput($input);
}

/**
 * Send filter reset to the All content tab (all types, no default story filter).
 */
function story_pipeline_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\views\ViewExecutable|null $view */
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'content' || $view->current_display !== 'page_1') {
    return;
  }
  if (isset($form['actions']['reset'])) {
    $form['actions']['reset']['#submit'][] = 'story_pipeline_content_exposed_reset_submit';
  }
}

/**
 * Submit handler: redirect reset to All content listing.
 */
function story_pipeline_content_exposed_reset_submit(array &$form, FormStateInterface $form_state): void {
  $form_state->setRedirect('view.content.page_1', [], ['query' => ['all' => '1']]);
}

/**
 * Hide Characters tab on non-story node edit forms; add content admin tabs.
 */
function story_pipeline_menu_local_tasks_alter(array &$data, $route_name, \Drupal\Core\Cache\RefinableCacheableDependencyInterface $cacheability): void {
  if ($route_name === 'view.content.page_1') {
    $show_all = \Drupal::request()->query->get('all') === '1';
    unset($data['tabs'][0]['system.admin_content']);
    $data['tabs'][0]['story_pipeline.content_stories'] = [
      '#theme' => 'menu_local_task',
      '#link' => [
        'title' => t('Stories'),
        'url' => Url::fromRoute('view.content.page_1'),
      ],
      '#active' => !$show_all,
    ];
    $data['tabs'][0]['story_pipeline.content_all'] = [
      '#theme' => 'menu_local_task',
      '#link' => [
        'title' => t('All content'),
        'url' => Url::fromRoute('view.content.page_1', [], ['query' => ['all' => '1']]),
      ],
      '#active' => $show_all,
    ];
    $cacheability->addCacheContexts(['url.query_args:all']);
  }

  if (!in_array($route_name, ['entity.node.edit_form', 'entity.node.canonical'], TRUE)) {
    return;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'story') {
    foreach (['story_pipeline.story_characters_tab', 'story_pipeline.story_characters_view_tab'] as $tab_id) {
      if (isset($data['tabs'][0][$tab_id])) {
        unset($data['tabs'][0][$tab_id]);
      }
    }
    return;
  }

  /** @var \Drupal\story_pipeline\Service\CharacterLibrary $character_library */
  $character_library = \Drupal::service('story_pipeline.character_library');
  $status = $character_library->getCharacterStatus($node);
  if ($status['applied'] > 0 || $status['tagged'] > 0 || $status['total'] > 0) {
    $label = (string) t('Characters (@tagged/@total)', [
      '@tagged' => $status['tagged'],
      '@total' => $status['total'],
    ]);
    foreach (['story_pipeline.story_characters_tab', 'story_pipeline.story_characters_view_tab'] as $tab_id) {
      if (isset($data['tabs'][0][$tab_id])) {
        $data['tabs'][0][$tab_id]['#link']['title'] = $label;
      }
    }
    $cacheability->addCacheableDependency($node);
  }
}

/**
 * Configures form displays for Story and Story Type fields.
 */
function story_pipeline_configure_displays(): void {
  $story_display = EntityFormDisplay::load('node.story.default');
  if (!$story_display) {
    $story_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'story',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $components = [
    'title' => ['type' => 'string_textfield', 'weight' => 0],
    'field_story_type' => ['type' => 'options_select', 'weight' => 1],
    'field_youtube_urls' => ['type' => 'string_textfield', 'weight' => 2],
    'field_transcript' => ['type' => 'text_textarea', 'weight' => 3],
    'field_bullet_ledger' => ['type' => 'text_textarea', 'weight' => 4],
    'field_story_plan_raw' => ['type' => 'text_textarea', 'weight' => 5],
    'field_story_raw_file' => ['type' => 'file_generic', 'weight' => 6],
    'field_characters_info' => ['type' => 'text_textarea', 'weight' => 7],
    'field_bilingual' => ['type' => 'boolean_checkbox', 'weight' => 8],
    'field_full_story' => ['type' => 'text_textarea', 'weight' => 9],
    'field_full_story_english' => ['type' => 'text_textarea', 'weight' => 10],
    'field_story_meta' => ['type' => 'text_textarea', 'weight' => 11],
    'field_status' => ['type' => 'options_select', 'weight' => 12],
    'field_stage_a_output' => ['type' => 'text_textarea', 'weight' => 13],
    'field_stage_b_output' => ['type' => 'text_textarea', 'weight' => 14],
    'field_prompt_file' => ['type' => 'file_generic', 'weight' => 15],
    'field_scene_file' => ['type' => 'file_generic', 'weight' => 16],
    'field_image_prompts_file' => ['type' => 'file_generic', 'weight' => 17],
    'field_eleven_labs_files' => ['type' => 'file_generic', 'weight' => 18],
    'field_eleven_labs_files_english' => ['type' => 'file_generic', 'weight' => 19],
  ];
  foreach ($components as $name => $options) {
    $story_display->setComponent($name, $options);
  }
  $story_display->save();

  $term_display = EntityFormDisplay::load('taxonomy_term.story_type.default');
  if (!$term_display) {
    $term_display = EntityFormDisplay::create([
      'targetEntityType' => 'taxonomy_term',
      'bundle' => 'story_type',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $term_components = [
    'name' => ['type' => 'string_textfield', 'weight' => 0],
    'field_master_prompt' => ['type' => 'text_textarea', 'weight' => 1],
    'field_stage_a' => ['type' => 'text_textarea', 'weight' => 2],
    'field_stage_b' => ['type' => 'text_textarea', 'weight' => 3],
    'field_stage_c' => ['type' => 'text_textarea', 'weight' => 4],
    'field_default_characters' => ['type' => 'text_textarea', 'weight' => 5],
    'field_pipeline_settings' => ['type' => 'text_textarea', 'weight' => 6],
    'field_voice_id' => ['type' => 'string_textfield', 'weight' => 7],
  ];
  foreach ($term_components as $name => $options) {
    $term_display->setComponent($name, $options);
  }
  $term_display->save();

  story_pipeline_configure_taxonomy_term_diffs();
}

/**
 * Enable Diff comparison for Story Type taxonomy prompt fields.
 *
 * Diff only auto-compares fields that appear on a view display. Story Type
 * prompts are form-only, so revision compare otherwise shows only the name
 * and looks empty. This also prefers the split-fields layout, which can
 * actually show those long text changes.
 */
function story_pipeline_configure_taxonomy_term_diffs(): void {
  if (!\Drupal::moduleHandler()->moduleExists('diff')) {
    return;
  }

  $diff_builder_manager = \Drupal::service('plugin.manager.diff.builder');
  $field_definitions = \Drupal::service('entity_field.manager')
    ->getFieldDefinitions('taxonomy_term', 'story_type');

  $config = \Drupal::configFactory()->getEditable('diff.plugins');
  $base_fields = ['name', 'description'];

  foreach ($field_definitions as $field_name => $definition) {
    $storage_definition = $definition->getFieldStorageDefinition();
    $is_configurable = $storage_definition instanceof FieldStorageConfig;
    if (!$is_configurable && !in_array($field_name, $base_fields, TRUE)) {
      continue;
    }
    if (!$diff_builder_manager->showDiff($storage_definition)) {
      continue;
    }
    $plugin_options = $diff_builder_manager->getApplicablePluginOptions($storage_definition);
    if ($plugin_options === []) {
      continue;
    }

    $plugin_id = (string) array_key_first($plugin_options);
    $settings = [
      'show_header' => 1,
      'markdown' => 'filter_xss_all',
    ];
    if ($plugin_id === 'text_field_diff_builder') {
      $settings['compare_format'] = 0;
    }
    // Diff stores these as nested keys: fields.taxonomy_term.{field_name}.
    $config->set('fields.taxonomy_term.' . $field_name, [
      'type' => $plugin_id,
      'settings' => $settings,
    ]);
  }
  $config->save();

  $settings = \Drupal::configFactory()->getEditable('diff.settings');
  $settings->set('general_settings.layout_plugins.split_fields.enabled', TRUE);
  $settings->set('general_settings.layout_plugins.split_fields.weight', 0);
  $settings->set('general_settings.layout_plugins.unified_fields.enabled', TRUE);
  $settings->set('general_settings.layout_plugins.unified_fields.weight', 1);
  $settings->set('general_settings.layout_plugins.visual_inline.enabled', TRUE);
  $settings->set('general_settings.layout_plugins.visual_inline.weight', 2);
  $settings->save();
}

/**
 * Implements hook_entity_insert().
 */
function story_pipeline_entity_insert(EntityInterface $entity): void {
  story_pipeline_sync_raw_story_file($entity);
  story_pipeline_sync_uploaded_transcript($entity);
  story_pipeline_sync_english_story_file($entity);
}

/**
 * Implements hook_entity_update().
 */
function story_pipeline_entity_update(EntityInterface $entity): void {
  story_pipeline_sync_raw_story_file($entity);
  story_pipeline_sync_uploaded_transcript($entity);
  story_pipeline_sync_english_story_file($entity);
}

/**
 * Copy uploaded raw story file to story asset folder (script/raw-story.*).
 */
function story_pipeline_sync_raw_story_file(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'story') {
    return;
  }
  if (!$entity->hasField('field_story_raw_file')) {
    return;
  }
  \Drupal::service('story_pipeline.asset_storage')->syncRawStoryFile($entity);
}

/**
 * Mirror pasted transcript to story asset folder (script/uploaded_transcript.txt).
 */
function story_pipeline_sync_uploaded_transcript(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'story') {
    return;
  }
  if (!$entity->hasField('field_transcript')) {
    return;
  }
  \Drupal::service('story_pipeline.asset_storage')->syncUploadedTranscript($entity);
}

/**
 * Mirror English story text to story asset folder (script/FULL_STORY_ENGLISH.txt).
 */
function story_pipeline_sync_english_story_file(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'story') {
    return;
  }
  if (!$entity->hasField('field_full_story_english')) {
    return;
  }
  $english = trim(strip_tags((string) ($entity->get('field_full_story_english')->value ?? '')));
  if ($english === '') {
    return;
  }
  \Drupal::service('story_pipeline.asset_storage')->saveText($entity, 'script', 'FULL_STORY_ENGLISH.txt', $english);
}
