DATABASE_URL="file:./dev.db"
LLM_PROVIDER="deepseek"
LLM_MODEL="deepseek-v4-pro"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_DEEP_THINKING="true"
DEEPSEEK_REASONING_EFFORT="high"
# Per-section ceiling for long-form narration: reserves output room after reasoning.
LLM_NARRATION_MAX_TOKENS="65536"

# Official YouTube captions (OAuth) — owned/authorized videos only
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/youtube/oauth/callback"

# Public YouTube captions are optional. Manual paste works without Python.
# Setup: python3 -m pip install -r scripts/requirements-transcript.txt
# YOUTUBE_TRANSCRIPT_PYTHON="python3"
# YOUTUBE_TRANSCRIPT_MIN_INTERVAL_MS="8000"
# YOUTUBE_TRANSCRIPT_MAX_RETRIES="2"
# YOUTUBE_TRANSCRIPT_BLOCK_COOLDOWN_MS="900000"
# YOUTUBE_TRANSCRIPT_TIMEOUT_MS="25000"
# YOUTUBE_TRANSCRIPT_MAX_OUTPUT_BYTES="1500000"
# Proxy support is off by default. A paid rotating residential proxy can reduce IP
# blocks, but it costs money and does not guarantee that YouTube will return captions.
# Story Studio never purchases or selects a proxy service for you.
# YOUTUBE_TRANSCRIPT_PROXY="off"
# YOUTUBE_TRANSCRIPT_WEBSHARE_USERNAME=""
# YOUTUBE_TRANSCRIPT_WEBSHARE_PASSWORD=""
# YOUTUBE_TRANSCRIPT_WEBSHARE_LOCATIONS=""
# YOUTUBE_TRANSCRIPT_HTTP_PROXY=""
# YOUTUBE_TRANSCRIPT_HTTPS_PROXY=""
