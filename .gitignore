# Ignore dependencies managed by Composer.
/vendor/

# Ignore configuration files that may contain sensitive information.
/web/sites/*/settings*.php
/web/sites/*/services*.yml

# Ignore paths that contain user-generated content.
/web/sites/*/files
/web/sites/*/private

# Ignore multi-site test environment.
/web/sites/simpletest

# OS and IDE files.
.DS_Store
Thumbs.db
/.idea/
/.vscode/

# Story Studio (Next.js app)
/story-studio/node_modules/
/story-studio/.next/
/story-studio/prisma/dev.db
/story-studio/prisma/dev.db-journal
/story-studio/.env
