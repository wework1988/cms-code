<?php

declare(strict_types=1);

/**
 * @file
 * Install, update and uninstall hooks for Story Pipeline.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 */
function story_pipeline_install(): void {
  // Story Type vocabulary.
  if (!Vocabulary::load('story_type')) {
    Vocabulary::create([
      'vid' => 'story_type',
      'name' => 'Story Type',
      'description' => 'General, Crime, English, God Story — holds all pipeline prompts.',
    ])->save();
  }

  // Taxonomy term fields (prompts live on each term).
  $term_fields = [
    'field_master_prompt' => 'Master prompt (story writing)',
    'field_stage_a' => 'Stage A config',
    'field_stage_b' => 'Stage B config',
    'field_stage_c' => 'Stage C config',
    'field_default_characters' => 'Default characters',
    'field_pipeline_settings' => 'Pipeline settings (JSON)',
  ];
  foreach ($term_fields as $field_name => $label) {
    story_pipeline_create_text_field('taxonomy_term', 'story_type', $field_name, $label);
  }
  story_pipeline_create_string_field('taxonomy_term', 'story_type', 'field_voice_id', 'ElevenLabs voice ID');

  // Story content type.
  if (!NodeType::load('story')) {
    NodeType::create([
      'type' => 'story',
      'name' => 'Story',
      'description' => 'One episode — script in, storyboard artifacts out.',
    ])->save();
  }

  // Story node fields.
  story_pipeline_create_text_field('node', 'story', 'field_transcript', 'Transcript');
  $transcript_field = FieldConfig::loadByName('node', 'story', 'field_transcript');
  if ($transcript_field) {
    $transcript_field->setDescription('Paste a transcript instead of YouTube URLs. Run “Prepare bullets from transcript” — skips download and does not write a full script.');
    $transcript_field->save();
  }
  story_pipeline_create_text_field('node', 'story', 'field_bullet_ledger', 'Bullet ledger');
  $ledger_field = FieldConfig::loadByName('node', 'story', 'field_bullet_ledger');
  if ($ledger_field) {
    $ledger_field->setDescription('Story pointers extracted from the transcript by the pipeline. Populated after “Prepare bullets from transcript”.');
    $ledger_field->save();
  }
  story_pipeline_create_text_field('node', 'story', 'field_characters_info', 'Characters info');
  story_pipeline_create_text_field('node', 'story', 'field_full_story', 'Full story');
  story_pipeline_create_text_field('node', 'story', 'field_story_meta', 'Story meta');
  story_pipeline_create_text_field('node', 'story', 'field_stage_a_output', 'Stage A output');
  story_pipeline_create_text_field('node', 'story', 'field_stage_b_output', 'Stage B output');

  // YouTube URLs — unlimited strings.
  if (!FieldStorageConfig::loadByName('node', 'field_youtube_urls')) {
    FieldStorageConfig::create([
      'field_name' => 'field_youtube_urls',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => -1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_youtube_urls')) {
    FieldConfig::create([
      'field_name' => 'field_youtube_urls',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'YouTube URLs',
      'settings' => [],
    ])->save();
  }

  // Story type taxonomy reference.
  if (!FieldStorageConfig::loadByName('node', 'field_story_type')) {
    FieldStorageConfig::create([
      'field_name' => 'field_story_type',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_story_type')) {
    FieldConfig::create([
      'field_name' => 'field_story_type',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'Story type',
      'required' => TRUE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['story_type' => 'story_type'],
        ],
      ],
    ])->save();
  }

  // Status list field.
  if (!FieldStorageConfig::loadByName('node', 'field_status')) {
    FieldStorageConfig::create([
      'field_name' => 'field_status',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'draft' => 'Draft',
          'research_done' => 'Research done (bullets only)',
          'story_generated' => 'Story generated',
          'storyboard_running' => 'Storyboard running',
          'storyboard_done' => 'Storyboard done',
          'live' => 'Live',
          'stopped' => 'Stopped',
          'failed' => 'Failed',
        ],
      ],
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_status')) {
    FieldConfig::create([
      'field_name' => 'field_status',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'Status',
      'default_value' => [['value' => 'draft']],
    ])->save();
  }

  // File fields for prompt.txt and scene.txt.
  foreach ([
    'field_prompt_file' => 'Prompt file',
    'field_scene_file' => 'Scene file',
    'field_story_raw_file' => 'Raw story file',
  ] as $fname => $label) {
    story_pipeline_create_story_file_field($fname, $label, $fname === 'field_story_raw_file' ? 'txt md text' : 'txt md');
  }

  // Default taxonomy terms.
  $defaults = [
    'general' => 'General',
    'crime' => 'Crime',
    'english' => 'English',
    'god_story' => 'God Story',
  ];
  $settings_json = json_encode([
    'model' => 'deepseek-v4-pro',
    'scene_batch' => 8,
    'max_tokens_a' => 65536,
    'max_tokens_b' => 131072,
    'max_tokens_c' => 65536,
  ], JSON_PRETTY_PRINT);

  foreach ($defaults as $machine => $label) {
    $existing = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadByProperties(['vid' => 'story_type', 'name' => $label]);
    if ($existing) {
      continue;
    }
    Term::create([
      'vid' => 'story_type',
      'name' => $label,
      'field_pipeline_settings' => ['value' => $settings_json],
      'field_voice_id' => match ($machine) {
        'general' => 'jHizw5Q9vzu8Pr4RakeJ',
        'english' => 'rWZtlKG7bkWHglNRo3ZA',
        'god_story' => 'FZkK3TvQ0pjyDmT8fzIW',
        default => '',
      },
    ])->save();
  }

  // Grant API permission to admin role.
  story_pipeline_grant_staff_permissions();

  // Default API key for local dev (change in admin UI).
  $empty_keys = [
    'deepseek_api_key' => '',
    'anthropic_api_key' => '',
    'elevenlabs_api_key' => '',
  ];
  \Drupal::configFactory()->getEditable('story_pipeline.settings')
    ->set('api_key', bin2hex(random_bytes(16)))
    ->set('automation_repo_path', '/Users/averma/project/research-story-17thmay-automation')
    ->set('worker_path', '/Applications/MAMP/htdocs/story-pipeline-worker')
    ->set('pipeline_api_keys', $empty_keys)
    ->set('story_type_keys', [
      'general' => $empty_keys,
      'crime' => $empty_keys,
      'english' => $empty_keys,
      'god_story' => $empty_keys,
    ])
    ->save();

  story_pipeline_configure_displays();
}

/**
 * Creates a text_long field storage + instance if missing.
 */
function story_pipeline_create_text_field(string $entity_type, string $bundle, string $field_name, string $label): void {
  if (!FieldStorageConfig::loadByName($entity_type, $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'type' => 'text_long',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $label,
    ])->save();
  }
}

/**
 * Creates a file field storage + story instance if missing.
 */
function story_pipeline_create_story_file_field(string $field_name, string $label, string $extensions = 'txt md'): void {
  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => ['target_type' => 'file', 'display_field' => FALSE, 'display_default' => FALSE],
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', $field_name)) {
    $field = FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => $label,
      'settings' => [
        'file_extensions' => $extensions,
        'file_directory' => 'story-pipeline/[date:custom:Y-m]',
      ],
    ]);
    if ($field_name === 'field_story_raw_file') {
      $field->setDescription('Upload the full story output file (validator, TOP 10 CHARACTERS, script, etc.). Saved to the story asset folder as script/raw-story.txt when you save or run jobs.');
    }
    $field->save();
  }
}

/**
 * Implements hook_schema().
 */
function story_pipeline_schema(): array {
  $schema['story_pipeline_tracker'] = [
    'description' => 'Planned stories and production checklist (independent of content types).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'title' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => TRUE,
      ],
      'story_written' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'image_prompt_generated' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'image_generated' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'digen_video_generated' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'completed_assigned' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'default' => 'planning',
      ],
      'weight' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'expected_publish' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'story_type_tid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'story_nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'completed_assigned' => ['completed_assigned'],
      'status' => ['status'],
      'status_weight' => ['status', 'weight'],
      'story_type_tid' => ['story_type_tid'],
      'story_nid' => ['story_nid'],
      'expected_publish' => ['expected_publish'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function story_pipeline_uninstall(): void {
  $schema = story_pipeline_schema();
  foreach (array_keys($schema) as $table) {
    \Drupal::database()->schema()->dropTable($table);
  }
}

/**
 * Configure form displays on existing sites.
 */
function story_pipeline_update_9001(): void {
  story_pipeline_configure_displays();
}

