/**
 * Add per-story-type API keys structure to config.
 */
function story_pipeline_update_9002(): void {
  $config = \Drupal::configFactory()->getEditable('story_pipeline.settings');
  if ($config->get('story_type_keys')) {
    return;
  }
  $empty = [
    'deepseek_api_key' => '',
    'anthropic_api_key' => '',
    'elevenlabs_api_key' => '',
  ];
  $config->set('story_type_keys', [
    'general' => $empty,
    'crime' => $empty,
    'english' => $empty,
  ])->save();
}

/**
 * Global pipeline API keys + import from automation repo .env.
 */
function story_pipeline_update_9004(): void {
  $config = \Drupal::configFactory()->getEditable('story_pipeline.settings');
  if (!$config->get('pipeline_api_keys')) {
    $config->set('pipeline_api_keys', [
      'deepseek_api_key' => '',
      'anthropic_api_key' => '',
      'elevenlabs_api_key' => '',
    ]);
    $config->save();
  }

  try {
    \Drupal::service('story_pipeline.manager')->importKeysFromEnv(NULL, FALSE);
  }
  catch (\Throwable $e) {
    \Drupal::logger('story_pipeline')->warning('Could not auto-import API keys: @msg', ['@msg' => $e->getMessage()]);
  }
}

/**
 * Add "stopped" status for cancelled jobs.
 */
function story_pipeline_update_9006(): void {
  $storage = FieldStorageConfig::loadByName('node', 'field_status');
  if (!$storage) {
    return;
  }
  $allowed = $storage->getSetting('allowed_values') ?? [];
  if (!isset($allowed['stopped'])) {
    $allowed['stopped'] = 'Stopped';
    $storage->setSetting('allowed_values', $allowed);
    $storage->save();
  }
}

/**
 * Story outputs folder outside Drupal (prompts, scenes, audio, etc.).
 */
function story_pipeline_update_9007(): void {
  $config = \Drupal::configFactory()->getEditable('story_pipeline.settings');
  if (!$config->get('story_asset_path')) {
    $config->set('story_asset_path', '/Users/averma/project/research-story-17thmay-automation/cms-generate-stories')->save();
  }
  $path = $config->get('story_asset_path');
  if ($path && !is_dir($path)) {
    @mkdir($path, 0775, TRUE);
  }
}

/**
 * Story tracker table + permission for administrators.
 */
function story_pipeline_update_9008(): void {
  $schema = story_pipeline_schema();
  $db_schema = \Drupal::database()->schema();
  if (!$db_schema->tableExists('story_pipeline_tracker')) {
    $db_schema->createTable('story_pipeline_tracker', $schema['story_pipeline_tracker']);
  }

  $admin_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('administrator');
  if ($admin_role) {
    $admin_role->grantPermission('track stories');
    $admin_role->save();
  }
}

/**
 * Grant story pipeline permissions to administrator role.
 */
function story_pipeline_grant_staff_permissions(): void {
  $permissions = [
    'manage story characters',
    'run story pipeline jobs',
    'administer story pipeline',
    'use story pipeline api',
    'track stories',
  ];
  $admin_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('administrator');
  if (!$admin_role) {
    return;
  }
  foreach ($permissions as $permission) {
    $admin_role->grantPermission($permission);
  }
  $admin_role->save();
}

/**
 * Story planner: planning / in-progress / completed statuses + priority weight.
 */
function story_pipeline_update_9009(): void {
  $schema = story_pipeline_schema();
  $db = \Drupal::database();
  $db_schema = $db->schema();

  if ($db_schema->tableExists('story_pipeline_tracker')) {
    if (!$db_schema->fieldExists('story_pipeline_tracker', 'status')) {
      $db_schema->addField('story_pipeline_tracker', 'status', $schema['story_pipeline_tracker']['fields']['status']);
    }
    if (!$db_schema->fieldExists('story_pipeline_tracker', 'weight')) {
      $db_schema->addField('story_pipeline_tracker', 'weight', $schema['story_pipeline_tracker']['fields']['weight']);
    }

    // Migrate existing rows (old UI had no planning queue).
    $rows = $db->select('story_pipeline_tracker', 't')->fields('t')->execute();
    $weight = 0;
    foreach ($rows as $row) {
      $status = !empty($row->completed_assigned) ? 'completed' : 'in_progress';
      $db->update('story_pipeline_tracker')
        ->fields([
          'status' => $status,
          'weight' => $weight++,
        ])
        ->condition('id', $row->id)
        ->execute();
    }
  }
}

/**
 * Story planner: story type (General / Crime / English taxonomy).
 */
function story_pipeline_update_9010(): void {
  $schema = story_pipeline_schema();
  $db = \Drupal::database();
  $db_schema = $db->schema();

  if ($db_schema->tableExists('story_pipeline_tracker')
    && !$db_schema->fieldExists('story_pipeline_tracker', 'story_type_tid')) {
    $db_schema->addField('story_pipeline_tracker', 'story_type_tid', $schema['story_pipeline_tracker']['fields']['story_type_tid']);
    if (!$db_schema->indexExists('story_pipeline_tracker', 'story_type_tid')) {
      $db_schema->addIndex('story_pipeline_tracker', 'story_type_tid', ['story_type_tid'], $schema['story_pipeline_tracker']);
    }

    $default_tid = \Drupal::service('story_pipeline.planner_types')->defaultTermId();
    if ($default_tid) {
      $db->update('story_pipeline_tracker')
        ->fields(['story_type_tid' => $default_tid])
        ->isNull('story_type_tid')
        ->execute();
    }
  }
}

/**
 * Run-jobs UI: worker path config + permission for administrators.
 */
function story_pipeline_update_9005(): void {
  $config = \Drupal::configFactory()->getEditable('story_pipeline.settings');
  if (!$config->get('worker_path')) {
    $config->set('worker_path', '/Applications/MAMP/htdocs/story-pipeline-worker')->save();
  }

  $admin_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('administrator');
  if ($admin_role) {
    $admin_role->grantPermission('run story pipeline jobs');
    $admin_role->save();
  }
}

/**
 * Character library content type + story character roster field.
 */
function story_pipeline_update_9011(): void {
  story_pipeline_install_character_library();

  if (!FieldConfig::loadByName('node', 'story', 'field_character_roster')) {
    story_pipeline_create_text_field('node', 'story', 'field_character_roster', 'Character roster (JSON, internal)');
  }

  $admin_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('administrator');
  if ($admin_role) {
    $admin_role->grantPermission('manage story characters');
    $admin_role->save();
  }

  // Seed library from repo character.txt if empty.
  $count = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'character_library')
    ->count()
    ->execute();
  if ((int) $count === 0) {
    try {
      $config = \Drupal::config('story_pipeline.settings');
      $repo = $config->get('automation_repo_path');
      $path = $repo . '/general-story/bifuracted-template/character.txt';
      $term = \Drupal::service('story_pipeline.manager')->loadStoryTypeTerm('general');
      $tid = $term ? (int) $term->id() : NULL;
      \Drupal::service('story_pipeline.character_library')->importFromFile($path, $tid, TRUE);
    }
    catch (\Throwable $e) {
      \Drupal::logger('story_pipeline')->warning('Character library seed import failed: @msg', ['@msg' => $e->getMessage()]);
    }
  }
}

/**
 * Create character_library content type and fields.
 */
function story_pipeline_install_character_library(): void {
  if (!NodeType::load('character_library')) {
    NodeType::create([
      'type' => 'character_library',
      'name' => 'Character library',
      'description' => 'Locked visual description for a recurring story character.',
    ])->save();
  }

  story_pipeline_create_string_field('node', 'character_library', 'field_char_id', 'Character ID', TRUE);
  story_pipeline_create_string_field('node', 'character_library', 'field_context_label', 'Context label', FALSE);
  story_pipeline_create_text_field('node', 'character_library', 'field_match_aliases', 'Match aliases');
  story_pipeline_create_text_field('node', 'character_library', 'field_locked_anchor', 'Locked visual prompt');
  story_pipeline_create_text_field('node', 'character_library', 'field_negative_firewall', 'Do-not-misclassify rules');

  if (!FieldStorageConfig::loadByName('node', 'field_story_type')) {
    // Reuse existing story type reference storage from story content type install.
  }
  if (!FieldConfig::loadByName('node', 'character_library', 'field_story_type')) {
    FieldConfig::create([
      'field_name' => 'field_story_type',
      'entity_type' => 'node',
      'bundle' => 'character_library',
      'label' => 'Story type',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['story_type' => 'story_type'],
        ],
      ],
    ])->save();
  }

  $display = EntityFormDisplay::load('node.character_library.default');
  if (!$display) {
    $display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'character_library',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $components = [
    'title' => ['type' => 'string_textfield', 'weight' => 0],
    'field_char_id' => ['type' => 'string_textfield', 'weight' => 1],
    'field_context_label' => ['type' => 'string_textfield', 'weight' => 2],
    'field_story_type' => ['type' => 'options_select', 'weight' => 3],
    'field_match_aliases' => ['type' => 'text_textarea', 'weight' => 4],
    'field_locked_anchor' => ['type' => 'text_textarea', 'weight' => 5],
    'field_negative_firewall' => ['type' => 'text_textarea', 'weight' => 6],
  ];
  foreach ($components as $name => $options) {
    $display->setComponent($name, $options);
  }
  $display->save();
}

/**
 * Creates a string field storage + instance if missing.
 */
function story_pipeline_create_string_field(string $entity_type, string $bundle, string $field_name, string $label, bool $required = FALSE): void {
  if (!FieldStorageConfig::loadByName($entity_type, $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'type' => 'string',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $label,
      'required' => $required,
    ])->save();
  }
}

/**
 * Re-sync character library aliases/anchors from repo character.txt.
 */
function story_pipeline_update_9012(): void {
  try {
    $config = \Drupal::config('story_pipeline.settings');
    $repo = $config->get('automation_repo_path');
    $path = $repo . '/general-story/bifuracted-template/character.txt';
    $term = \Drupal::service('story_pipeline.manager')->loadStoryTypeTerm('general');
    $tid = $term ? (int) $term->id() : NULL;
    \Drupal::service('story_pipeline.character_library')->importFromFile($path, $tid, FALSE);
  }
  catch (\Throwable $e) {
    \Drupal::logger('story_pipeline')->warning('Character library resync failed: @msg', ['@msg' => $e->getMessage()]);
  }
}

/**
 * Story plan field (character extraction source) + grant pipeline permissions.
 */
function story_pipeline_update_9013(): void {
  if (!FieldConfig::loadByName('node', 'story', 'field_story_plan_raw')) {
    story_pipeline_create_text_field('node', 'story', 'field_story_plan_raw', 'Story plan (with characters)');
    $field = FieldConfig::loadByName('node', 'story', 'field_story_plan_raw');
    if ($field) {
      $field->setDescription('Paste the full planned story file here (validator + TOP 10 CHARACTERS + FULL SCRIPT). Used only for character extraction. Does not replace Full story for the pipeline.');
      $field->save();
    }
  }

  story_pipeline_configure_displays();
  story_pipeline_grant_staff_permissions();
}

/**
 * God Story type + ElevenLabs voice ID field on Story Type taxonomy.
 */
function story_pipeline_update_9014(): void {
  story_pipeline_create_string_field('taxonomy_term', 'story_type', 'field_voice_id', 'ElevenLabs voice ID');

  $term_display = EntityFormDisplay::load('taxonomy_term.story_type.default');
  if ($term_display) {
    $term_display->setComponent('field_voice_id', [
      'type' => 'string_textfield',
      'weight' => 7,
    ]);
    $term_display->save();
  }

  $settings_json = json_encode([
    'model' => 'deepseek-v4-pro',
    'scene_batch' => 8,
    'max_tokens_a' => 65536,
    'max_tokens_b' => 131072,
    'max_tokens_c' => 65536,
  ], JSON_PRETTY_PRINT);

  $existing = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'story_type', 'name' => 'God Story']);
  if ($existing) {
    $term = reset($existing);
    if ($term->hasField('field_voice_id') && $term->get('field_voice_id')->isEmpty()) {
      $term->set('field_voice_id', 'FZkK3TvQ0pjyDmT8fzIW');
      $term->save();
    }
  }
  else {
    Term::create([
      'vid' => 'story_type',
      'name' => 'God Story',
      'field_pipeline_settings' => ['value' => $settings_json],
      'field_voice_id' => 'FZkK3TvQ0pjyDmT8fzIW',
    ])->save();
  }

  $config = \Drupal::configFactory()->getEditable('story_pipeline.settings');
  $keys = $config->get('story_type_keys') ?? [];
  if (!isset($keys['god_story'])) {
    $empty_keys = [
      'deepseek_api_key' => '',
      'anthropic_api_key' => '',
      'elevenlabs_api_key' => '',
    ];
    $keys['god_story'] = $empty_keys;
    $config->set('story_type_keys', $keys)->save();
  }
}

/**
 * Import pipeline prompts into God Story if still empty.
 */
function story_pipeline_update_9015(): void {
  $term = \Drupal::service('story_pipeline.manager')->loadStoryTypeTerm('god_story');
  if (!$term) {
    return;
  }
  $stage_a = trim((string) ($term->get('field_stage_a')->value ?? ''));
  if ($stage_a === '') {
    try {
      \Drupal::service('story_pipeline.manager')->importPrompts();
    }
    catch (\Throwable $e) {
      \Drupal::logger('story_pipeline')->warning('God Story prompt import failed: @msg', ['@msg' => $e->getMessage()]);
    }
  }
}

/**
 * Story planner: link each row to a Drupal Story node.
 */
function story_pipeline_update_9016(): void {
  $schema = story_pipeline_schema();
  $db_schema = \Drupal::database()->schema();

  if ($db_schema->tableExists('story_pipeline_tracker')
    && !$db_schema->fieldExists('story_pipeline_tracker', 'story_nid')) {
    $db_schema->addField('story_pipeline_tracker', 'story_nid', $schema['story_pipeline_tracker']['fields']['story_nid']);
    if (!$db_schema->indexExists('story_pipeline_tracker', 'story_nid')) {
      $db_schema->addIndex('story_pipeline_tracker', 'story_nid', ['story_nid'], $schema['story_pipeline_tracker']);
    }
  }
}

/**
 * Raw story file upload on Story nodes + asset folder sync as script/raw-story.*.
 */
function story_pipeline_update_9017(): void {
  story_pipeline_create_story_file_field('field_story_raw_file', 'Raw story file', 'txt md text');
  story_pipeline_configure_displays();
}

/**
 * Auto-link existing planner rows to story nodes by title match.
 */
function story_pipeline_update_9018(): void {
  if (!\Drupal::database()->schema()->tableExists('story_pipeline_tracker')) {
    return;
  }
  $stats = \Drupal::service('story_pipeline.planner_node_sync')->linkUnlinkedPlans();
  \Drupal::logger('story_pipeline')->notice('Story planner node sync: @linked linked, @draft still draft.', [
    '@linked' => $stats['linked'],
    '@draft' => $stats['draft'],
  ]);
}

/**
 * Sync general-story bifurcated templates into Story Type taxonomy terms.
 */
function story_pipeline_update_9019(): void {
  try {
    $report = \Drupal::service('story_pipeline.manager')->importPrompts();
    \Drupal::logger('story_pipeline')->notice('Prompt import after template update: @report', [
      '@report' => json_encode($report),
    ]);
  }
  catch (\Throwable $e) {
    \Drupal::logger('story_pipeline')->warning('Prompt import failed: @msg', ['@msg' => $e->getMessage()]);
  }
}

/**
 * Add "live" status for stories moved off the Completed tab.
 */
function story_pipeline_update_9020(): void {
  $storage = FieldStorageConfig::loadByName('node', 'field_status');
  if (!$storage) {
    return;
  }
  $allowed = $storage->getSetting('allowed_values') ?? [];
  if (!isset($allowed['live'])) {
    $allowed['live'] = 'Live';
    $storage->setSetting('allowed_values', $allowed);
    $storage->save();
  }
}

/**
 * Bilingual story support: English script, checkbox, and English narration files.
 */
function story_pipeline_update_9021(): void {
  story_pipeline_create_text_field('node', 'story', 'field_full_story_english', 'Full story (English)');

  if (!FieldStorageConfig::loadByName('node', 'field_bilingual')) {
    FieldStorageConfig::create([
      'field_name' => 'field_bilingual',
      'entity_type' => 'node',
      'type' => 'boolean',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_bilingual')) {
    FieldConfig::create([
      'field_name' => 'field_bilingual',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'Has Hindi and English versions',
      'description' => 'When checked, narration jobs can generate Hindi audio, English audio, or both.',
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_eleven_labs_files_english')) {
    FieldStorageConfig::create([
      'field_name' => 'field_eleven_labs_files_english',
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => ['target_type' => 'file', 'display_field' => FALSE, 'display_default' => FALSE],
      'cardinality' => -1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'story', 'field_eleven_labs_files_english')) {
    FieldConfig::create([
      'field_name' => 'field_eleven_labs_files_english',
      'entity_type' => 'node',
      'bundle' => 'story',
      'label' => 'ElevenLabs audio (English)',
      'settings' => ['file_extensions' => 'mp3', 'file_directory' => 'story-pipeline/eleven-labs-english/[date:custom:Y-m]'],
    ])->save();
  }

  $full_story = FieldConfig::loadByName('node', 'story', 'field_full_story');
  if ($full_story) {
    $full_story->setLabel('Full story (Hindi)');
    $full_story->save();
  }

  story_pipeline_configure_displays();
}

/**
 * Show Story Type taxonomy field diffs on the Revisions compare page.
 */
function story_pipeline_update_9029(): void {
  story_pipeline_configure_taxonomy_term_diffs();
}

/**
 * Pasted transcript + bullet ledger fields; research_done status for bullets-only runs.
 */
function story_pipeline_update_9030(): void {
  story_pipeline_create_text_field('node', 'story', 'field_transcript', 'Transcript');
  $transcript_field = FieldConfig::loadByName('node', 'story', 'field_transcript');
  if ($transcript_field) {
    $transcript_field->setDescription('Paste a transcript instead of YouTube URLs. Run “Prepare bullets from transcript” — skips download and does not write a full script.');
    $transcript_field->save();
  }

  story_pipeline_create_text_field('node', 'story', 'field_bullet_ledger', 'Bullet ledger');
  $ledger_field = FieldConfig::loadByName('node', 'story', 'field_bullet_ledger');
  if ($ledger_field) {
    $ledger_field->setDescription('Story pointers extracted from the transcript by the pipeline. Populated after “Prepare bullets from transcript”.');
    $ledger_field->save();
  }

  $storage = FieldStorageConfig::loadByName('node', 'field_status');
  if ($storage) {
    $allowed = $storage->getSetting('allowed_values') ?? [];
    if (!isset($allowed['research_done'])) {
      $allowed['research_done'] = 'Research done (bullets only)';
      $storage->setSetting('allowed_values', $allowed);
      $storage->save();
    }
  }

  story_pipeline_configure_displays();
}
